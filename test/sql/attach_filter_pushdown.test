# name: test/sql/attach_filter_pushdown.test
# description: Test filter pushdown for expressions when remote execute is not supported
# group: [sql]

require mysql_scanner

require-env MYSQL_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'host=localhost user=root port="0" database="mysqlscanner"' AS s (TYPE MYSQL)

statement ok
CREATE OR REPLACE TABLE s.filter_pushdown_test(col1 INTEGER, col2 VARCHAR)

statement ok
INSERT INTO s.filter_pushdown_test values (41, 'foo'), (42, 'bar'), (44, NULL)

# ExpressionClass::BOUND_CONJUNCTION

# ExpressionType::CONJUNCTION_AND

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 = 41 AND col2 = 'foo'
----
41

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 = 41 AND col2 = 'foo'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col1 = 41.*col2 = 'foo'.*

# ExpressionType::CONJUNCTION_OR

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE (col1 = 41 AND col2 = 'foo') OR col2 = 'bar'
----
41
42

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE (col1 = 41 AND col2 = 'foo') OR col2 = 'bar'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters:.*\(\(col2 = 'foo'\) OR \(col2 = 'bar'\)\).*

# ExpressionClass::BOUND_OPERATOR

# ExpressionType::OPERATOR_IS_NULL

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 IS NULL
----
44

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 IS NULL
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col2 IS NULL.*

# ExpressionType::OPERATOR_IS_NOT_NULL

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 IS NOT NULL
----
41
42

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 IS NOT NULL
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col2 IS NOT NULL.*

# ExpressionType::COMPARE_IN:

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 IN (41, 44)
----
41
44

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 IN (41, 44)
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: optional: \(col1 IN \(41, 44\)\).*

# indirect reference

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE len(col2) IN (3, 4)
----
41
42

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE len(col2) IN (3, 4)
----
physical_plan	<!REGEX>:.*Mysql Scan.*Filters:.*

# ExpressionClass::BOUND_FUNCTION

# ExpressionType::COMPARE_EQUAL:

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 = 41
----
41

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 = 41
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col1 = 41.*

# ExpressionType::COMPARE_NOTEQUAL:

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 != 41
----
42
44

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 != 41
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col1 != 41.*

# ExpressionType::COMPARE_LESSTHAN:

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 < 42
----
41

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 < 42
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col1 < 42.*

# ExpressionType::COMPARE_GREATERTHAN:

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 > 42
----
44

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 > 42
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col1 > 42.*

# ExpressionType::COMPARE_LESSTHANOREQUALTO:

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 <= 41
----
41

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 <= 41
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col1 <= 41.*

# ExpressionType::COMPARE_GREATERTHANOREQUALTO:

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 >= 44
----
44

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col1 >= 44
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col1 >= 44.*

# ExpressionType::COMPARE_DISTINCT_FROM:

# TODO
mode skip

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 IS DISTINCT FROM NULL
----
41
42

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 IS DISTINCT FROM NULL
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col2 IS DISTINCT FROM NULL.*

# ExpressionType::COMPARE_NOT_DISTINCT_FROM:

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 IS NOT DISTINCT FROM NULL
----
44

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 IS NOT DISTINCT FROM NULL
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col2 IS NOT DISTINCT FROM NULL.*

# TODO
mode unskip

# VARCHAR comparison logic

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 = 'foo'
----
41

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 = 'foo'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col2 = 'foo'.*

query I
FROM mysql_query('s', 'SELECT col1 FROM filter_pushdown_test WHERE col2 = ''FOO''')
----
41

query I
SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 = 'FOO'

query II
EXPLAIN SELECT divide(col1, 1) FROM s.filter_pushdown_test WHERE col2 = 'FOO'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: col2 = 'FOO'.*

statement ok
DROP TABLE s.filter_pushdown_test

# VARCHAR

statement ok
CREATE OR REPLACE TABLE s.filter_pushdown_string(i STRING)

statement ok
INSERT INTO s.filter_pushdown_string SELECT CAST(range AS STRING) FROM range(10000);

query II
SELECT i, divide(len(i), 1) FROM s.filter_pushdown_string WHERE i = '5252'
----
5252	4

query II
EXPLAIN SELECT i, divide(len(i), 1) FROM s.filter_pushdown_string WHERE i = '5252'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: i = '5252'.*

query II
SELECT i, divide(len(i), 1) FROM s.filter_pushdown_string WHERE i > '10' ORDER BY i LIMIT 10
----
100	3
1000	4
1001	4
1002	4
1003	4
1004	4
1005	4
1006	4
1007	4
1008	4

query II
EXPLAIN SELECT i, divide(len(i), 1) FROM s.filter_pushdown_string WHERE i > '10' ORDER BY i LIMIT 10
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters:.*i > '10'.*

statement ok
DROP TABLE s.filter_pushdown_string

# timestamp pushdown

query I
SELECT divide(COUNT(*), 1) FROM s.datetime_tbl WHERE d >= DATE '2000-01-01'
----
2

query II
EXPLAIN SELECT divide(COUNT(*), 1) FROM s.datetime_tbl WHERE d >= DATE '2000-01-01'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: d >= '2000-01-01'::DATE.*

query I
SELECT divide(COUNT(*), 1) FROM s.datetime_tbl WHERE date_time >= TIMESTAMP '2000-01-01'
----
2

query II
EXPLAIN SELECT divide(COUNT(*), 1) FROM s.datetime_tbl WHERE date_time >= TIMESTAMP '2000-01-01'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters:.*date_time >= '2000-01-01 00:00:00'::TIMESTAMP.*

query I
SELECT divide(COUNT(*), 1) FROM s.datetime_tbl WHERE ts >= TIMESTAMP '2000-01-01'
----
2

query II
EXPLAIN SELECT divide(COUNT(*), 1) FROM s.datetime_tbl WHERE ts >= TIMESTAMP '2000-01-01'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters:.*ts >= '2000-01-01 00:00:00'::TIMESTAMP.*

# boolean pushdown

query I
SELECT divide(b::INT, 1) FROM s.booleans WHERE b = true
----
1

query II
EXPLAIN SELECT divide(b::INT, 1) FROM s.booleans WHERE b = true
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: b = true.*

# string pushdown

query I
SELECT divide(COUNT(*), 1) FROM s.text_tbl WHERE v= '🦆'
----
1

query II
EXPLAIN SELECT divide(COUNT(*), 1) FROM s.text_tbl WHERE v= '🦆'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: v = '🦆'.*

# blob pushdown

query I
SELECT divide(COUNT(*), 1) FROM s.blob_tbl WHERE bl= BLOB '\x80'
----
1

query II
EXPLAIN SELECT divide(COUNT(*), 1) FROM s.blob_tbl WHERE bl= BLOB '\x80'
----
physical_plan	<REGEX>:.*Mysql Scan.*Filters: bl = '\\x80'::BLOB.*
