# name: test/sql/query_pin_connection.test
# description: Test connection pinning with mysql_query
# group: [sql]

require mysql_scanner

require-env MYSQL_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'host=localhost user=root port=3306 database=mysql' AS s (TYPE mysql);

statement error
SELECT mysql_pin_connection()
----
No function matches the given name and argument types

statement error
SELECT mysql_pin_connection(NULL)
----
Specified attached database name must be not null

statement error
SELECT mysql_pin_connection('fail')
----
Failed to find attached database

statement ok
SET VARIABLE conn = mysql_pin_connection('s')

statement error
SELECT mysql_close_pinned_connection('fail', 0)
----
Failed to find attached database

statement error
SELECT mysql_close_pinned_connection('s', 0)
----
not found in the specified attached database

statement ok
SELECT mysql_close_pinned_connection('s', getvariable('conn'))

statement error
SELECT mysql_close_pinned_connection('s', getvariable('conn'))
----
not found in the specified attached database

statement ok
RESET VARIABLE conn

statement ok
SET VARIABLE conn = mysql_pin_connection('s')

statement ok
CALL mysql_execute('s', 'SET @@session.time_zone = "+00:42"', connection=getvariable('conn'))

query I
FROM mysql_query('s', 'SELECT TIMEDIFF(NOW(), UTC_TIMESTAMP);', connection=getvariable('conn'))
----
00:42:00

statement error
FROM mysql_query('s', 'SELECT 42', connection=getvariable('conn'))
UNION ALL
FROM mysql_query('s', 'SELECT 43', connection=getvariable('conn'))
----
not found in the specified attached database

statement ok
SET VARIABLE conn2 = mysql_pin_connection('s')

query I
FROM mysql_query('s', 'SELECT 42', connection=getvariable('conn'))
UNION ALL
FROM mysql_query('s', 'SELECT 43', connection=getvariable('conn2'))
----
42
43

statement ok
SELECT mysql_close_pinned_connection('s', getvariable('conn2'))

statement ok
SELECT mysql_close_pinned_connection('s', getvariable('conn'))

statement ok
RESET VARIABLE conn1

statement ok
RESET VARIABLE conn

statement ok
DETACH s