# errors
statement error
FROM mysql_query('simple', 'SELEC 42')
----
Failed to prepare

# duplicate result column names are renamed (table functions require unique column names)
query II
FROM mysql_query('simple', 'SELECT 42 a, 42 a')
----
42	42

require icu

statement ok
SET TimeZone='UTC'

statement ok
SET mysql_session_time_zone = '+01:00'

query IIIIII
FROM mysql_query('simple', 'SELECT * FROM datetime_tbl ORDER BY id')
----
1	2020-02-03	2029-02-14 08:47:23	2029-02-14 14:47:23	23:59:59	1901
2	1000-01-01	1000-01-01 00:00:00	1970-01-01 06:00:01	-838:59:59	2155
3	9999-12-31	9999-12-31 23:59:59	2038-01-19 04:14:07	838:59:59	2000
4	NULL	NULL	NULL	NULL	NULL

# issue #65 - Decimal data type conversion issue with mysql_query function
query II
FROM mysql_query('simple', 'SELECT * FROM tbl_issue65')
----
1	1.11
2	2.22
3	3.33


query I
FROM mysql_query('simple', 'SELECT ''foo''', stream_results=TRUE)
----
foo

query I
FROM mysql_query('simple', 'SELECT ''foo''', stream_results=NULL)
UNION ALL
FROM mysql_query('simple', 'SELECT ''bar''', stream_results=NULL)
----
foo
bar

query I
FROM mysql_query('simple', 'SELECT ''foo''', stream_results=FALSE)
UNION ALL
FROM mysql_query('simple', 'SELECT ''bar''', stream_results=FALSE)
----
foo
bar

statement error
FROM mysql_query('simple', 'SELECT ''foo''', stream_results=TRUE)
UNION ALL
FROM mysql_query('simple', 'SELECT ''bar''', stream_results=TRUE)
----
Binder Error

statement ok
ATTACH 'host=localhost user=root port=0 database=mysqlscanner' AS simple2 (TYPE MYSQL_SCANNER)

query I
FROM mysql_query('simple', 'SELECT ''foo''', stream_results=TRUE)
UNION ALL
FROM mysql_query('simple2', 'SELECT ''bar''', stream_results=TRUE)
----
foo
bar

statement ok
DETACH simple2

query I
FROM mysql_query('simple', 'SELECT ?', params=row(42), stream_results=TRUE)
----
42

query I
SELECT column_type FROM (DESCRIBE FROM mysql_query('simple', 'SELECT ?', params=row(42), stream_results=TRUE))
----
VARCHAR

query I
FROM mysql_query('simple', 'SELECT ?', params=row(42), stream_results=NULL)
----
42

query I
SELECT column_type FROM (DESCRIBE FROM mysql_query('simple', 'SELECT ?', params=row(42), stream_results=NULL))
----
VARCHAR

query I
FROM mysql_query('simple', 'SELECT ?', params=row(42), stream_results=FALSE)
----
42

query I
SELECT column_type FROM (DESCRIBE FROM mysql_query('simple', 'SELECT ?', params=row(42), stream_results=FALSE))
----
VARCHAR

# test DML

query I
FROM mysql_query('simple', 'DROP TABLE IF EXISTS query_dml_test')
----
0

query I
FROM mysql_query('simple', 'CREATE TABLE query_dml_test(col1 INT)')
----
0

query I
FROM mysql_query('simple', 'INSERT INTO query_dml_test values(41), (42)')
----
2

query I
FROM mysql_query('simple', 'UPDATE query_dml_test SET col1 = 43')
----
2

query I
FROM mysql_query('simple', 'UPDATE query_dml_test SET col1 = 44 WHERE 1 < 0')
----
0

query II
SELECT column_name, column_type FROM (
  DESCRIBE FROM mysql_query('simple', 'UPDATE query_dml_test SET col1 = 44 WHERE 1 < 0')
)
----
rowcount	BIGINT

statement ok
CALL mysql_query('simple', 'DROP TABLE query_dml_test')

statement ok
DETACH simple;
