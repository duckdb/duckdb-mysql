# name: test/sql/remote_connect.test
# description: Test CONNECT statement
# group: [sql]

require mysql_scanner

require-env MYSQL_TEST_DATABASE_AVAILABLE

query I
SELECT current_database()
----
memory

statement ok
CONNECT 'host=localhost user=root port=0 database=mysqlscanner' (TYPE MYSQL)

query I
SELECT database()
----
mysqlscanner

statement ok
DROP TABLE IF EXISTS connect_test

statement ok
CREATE TABLE connect_test(col1 INT)

statement ok
INSERT INTO connect_test values (41), (42)

statement error
FROM connect_test
----
PREPARE error

query I
SELECT * FROM connect_test ORDER BY col1
----
41
42

# unittester ignores StatementReturnType::NOTHING
query I
UPDATE connect_test SET col1 = 43
----
2

statement ok
DROP TABLE connect_test

statement ok
DISCONNECT

query I
SELECT current_database()
----
memory
