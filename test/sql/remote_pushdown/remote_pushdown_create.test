# PRIMARY KEY

statement ok
CREATE OR REPLACE TABLE s.pushdown_create_test2(col1 INT, col2 BIGINT, PRIMARY KEY(col1, col2))

query IIIIII
FROM mysql_query('s', 'DESCRIBE pushdown_create_test2')
----
col1	int	NO	PRI	NULL	(empty)
col2	bigint	NO	PRI	NULL	(empty)

statement ok
CALL mysql_execute('s', 'DROP TABLE pushdown_create_test')

statement ok
DETACH s

statement ok
RESET mysql_enable_remote_pushdown_ddl
