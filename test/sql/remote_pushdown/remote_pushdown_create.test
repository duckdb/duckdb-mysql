# name: test/sql/remote_pushdown/remote_pushdown_create.test
# description: Test remote pushdown of CREATE into MySQL
# group: [remote_pushdown]

require mysql_scanner

require-env MYSQL_TEST_DATABASE_AVAILABLE

require-env ORACLE_MYSQL_SERVER

# statement ok
# SET mysql_debug_show_queries = TRUE

statement ok
ATTACH 'host=localhost user=root port=0 database=mysqlscanner' AS s (TYPE MYSQL)

statement ok
DETACH s

statement ok
SET mysql_enable_remote_pushdown_ddl = TRUE

statement ok
ATTACH 'host=localhost user=root port=0 database=mysqlscanner' AS s (TYPE MYSQL)

# basic

query II
EXPLAIN CREATE OR REPLACE TABLE s.pushdown_create_test(col1 INT)
----
physical_plan	<REGEX>:.*Function: MYSQL_QUERY.*

statement ok
CREATE OR REPLACE TABLE s.pushdown_create_test(col1 INT)

query IIIIII
FROM mysql_query('s', 'DESCRIBE pushdown_create_test')
----
col1	int	YES	(empty)	NULL	(empty)

# unsupported column types

query II
EXPLAIN CREATE OR REPLACE TABLE s.pushdown_create_test(col1 VARCHAR[])
----
physical_plan	<!REGEX>:.*Function: MYSQL_QUERY.*

statement error
CREATE OR REPLACE TABLE s.pushdown_create_test(col1 VARCHAR[])
----
unsupported type

# boolean

query II
EXPLAIN CREATE OR REPLACE TABLE s.pushdown_create_test(col1 INT)
----
physical_plan	<REGEX>:.*Function: MYSQL_QUERY.*

statement ok
CREATE OR REPLACE TABLE s.pushdown_create_test(col1 BOOLEAN)

query IIIIII
FROM mysql_query('s', 'DESCRIBE pushdown_create_test')
----
col1	tinyint(1)	YES	(empty)	NULL	(empty)

