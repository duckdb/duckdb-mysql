physical_plan	<REGEX>:.*Function: MYSQL_QUERY.*

statement ok
CREATE OR REPLACE TABLE s.pushdown_create_test(col1 UTINYINT, col2 USMALLINT, col3 UINTEGER, col4 UBIGINT)

