# decimals

query II
EXPLAIN CREATE OR REPLACE TABLE s.pushdown_create_test(col1 DECIMAL, col2 DECIMAL(18), col3 DECIMAL(4,3), col4 DECIMAL(9,3), col5 DECIMAL(18,3), col6 DECIMAL(38,3))
----
physical_plan	<REGEX>:.*Function: MYSQL_QUERY.*

statement ok
CREATE OR REPLACE TABLE s.pushdown_create_test(col1 DECIMAL, col2 DECIMAL(15), col3 DECIMAL(4,4), col4 DECIMAL(9,4), col5 DECIMAL(18,4), col6 DECIMAL(38,4))

query IIIIII
