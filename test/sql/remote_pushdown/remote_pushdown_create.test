col2	decimal(15,3)	YES	(empty)	NULL	(empty)
col3	decimal(4,4)	YES	(empty)	NULL	(empty)
col4	decimal(9,4)	YES	(empty)	NULL	(empty)
col5	decimal(18,4)	YES	(empty)	NULL	(empty)
col6	decimal(38,4)	YES	(empty)	NULL	(empty)

