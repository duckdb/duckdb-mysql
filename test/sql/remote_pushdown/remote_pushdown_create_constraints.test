# CHECK

query II
EXPLAIN CREATE OR REPLACE TABLE s.pushdown_create_constraints_test(col1 INT, CHECK (col1 > 42))
----
physical_plan	<REGEX>:.*Function: MYSQL_QUERY.*

statement ok
CREATE OR REPLACE TABLE s.pushdown_create_constraints_test(col1 INT, CHECK (col1 > 42))

statement ok
INSERT INTO s.pushdown_create_constraints_test values(43)

statement error
INSERT INTO s.pushdown_create_constraints_test values(42)
----
Check constraint 'pushdown_create_constraints_test_chk_1' is violated.

