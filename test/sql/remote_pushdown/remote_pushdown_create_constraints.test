# name: test/sql/remote_pushdown/remote_pushdown_create_constraints.test
# description: Test remote pushdown of CREATE constraints into MySQL
# group: [remote_pushdown]

require mysql_scanner

require-env MYSQL_TEST_DATABASE_AVAILABLE

require-env ORACLE_MYSQL_SERVER

statement ok
ATTACH 'host=localhost user=root port=0 database=mysqlscanner' AS s (TYPE MYSQL)

statement ok
DETACH s

statement ok
SET mysql_enable_remote_pushdown_ddl = TRUE

statement ok
ATTACH 'host=localhost user=root port=0 database=mysqlscanner' AS s (TYPE MYSQL)

# PRIMARY KEY

# single

query II
EXPLAIN CREATE OR REPLACE TABLE s.pushdown_create_constraints_test(col1 INT, col2 BIGINT PRIMARY KEY)
----
physical_plan	<REGEX>:.*Function: MYSQL_QUERY.*

statement ok
CREATE OR REPLACE TABLE s.pushdown_create_constraints_test(col1 INT, col2 BIGINT PRIMARY KEY)

query IIIIII
FROM mysql_query('s', 'DESCRIBE pushdown_create_constraints_test')
----
col1	int	YES	(empty)	NULL	(empty)
col2	bigint	NO	PRI	NULL	(empty)

