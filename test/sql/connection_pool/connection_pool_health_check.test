# name: test/sql/connection_pool/connection_pool_health_check.test
# description: Test connection pool health check query
# group: [connection_pool]

require mysql_scanner

require-env MYSQL_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'host=localhost user=root port=0 database=mysqlscanner' AS s (TYPE MYSQL)

query I
SELECT current_setting('mysql_pool_health_check_query')
----
(empty)

query II
SELECT catalog_name, available_connections
FROM mysql_configure_pool(catalog_name='s')
----
s	1

statement ok
DETACH s

# the health check is run every time the connection is taken from the pool (the alive bypass window is disabled
# by default)

statement ok
SET GLOBAL mysql_pool_health_check_query = 'SELECT_FAIL'

statement ok
ATTACH 'host=localhost user=root port=0 database=mysqlscanner' AS s (TYPE MYSQL)

query I
SELECT current_setting('mysql_pool_health_check_query')
----
SELECT_FAIL

# the health check is not run when the connection is returned to the pool
query II
SELECT catalog_name, available_connections
FROM mysql_configure_pool(catalog_name='s')
----
s	1

statement ok
SET VARIABLE cache_misses_before = (SELECT cache_misses FROM mysql_configure_pool(catalog_name='s'))

statement ok
SET VARIABLE conn_id_before = (SELECT id FROM mysql_query('s', 'SELECT CONNECTION_ID() AS id'))

query I
SELECT id <> getvariable('conn_id_before') FROM mysql_query('s', 'SELECT CONNECTION_ID() AS id')
----
true

# the connection failed the health check every time it was taken from the pool, it was discarded and a new one
# was opened
query III
SELECT catalog_name, available_connections, cache_misses - getvariable('cache_misses_before')
FROM mysql_configure_pool(catalog_name='s')
----
s	1	2

statement ok
DETACH s

# health check query returning multiple chunks of rows, the rows are drained,
# so the connection remains usable and is returned to the pool

statement ok
SET GLOBAL mysql_pool_health_check_query = 'SELECT * FROM large_tbl'

statement ok
ATTACH 'host=localhost user=root port=0 database=mysqlscanner' AS s (TYPE MYSQL)

query II
SELECT catalog_name, available_connections
FROM mysql_configure_pool(catalog_name='s')
----
s	1

statement ok
SET VARIABLE cache_misses_before = (SELECT cache_misses FROM mysql_configure_pool(catalog_name='s'))

query I
FROM mysql_query('s', 'SELECT 42')
----
42

query I
SELECT count(*) FROM s.large_tbl
----
100000

# the connection passed the health check every time it was taken from the pool and was reused
query III
SELECT catalog_name, available_connections, cache_misses - getvariable('cache_misses_before')
FROM mysql_configure_pool(catalog_name='s')
----
s	1	0

statement ok
RESET GLOBAL mysql_pool_health_check_query

statement ok
DETACH s
